{
  "name": "clocky-playtime",
  "version": "0.1.0",
  "private": true,
  "description": "Clocky Playtime Factory - a fan-inspired horror-puzzle desktop game.",
  "main": "electron/main.cjs",
  "scripts": {
    "build:renderer": "esbuild src/main.js --bundle --outfile=dist/renderer.bundle.js --format=iife --platform=browser",
    "start": "npm run build:renderer && electron .",
    "dev": "npm run build:renderer && electron . --dev",
    "build": "npm run build:renderer",
    "dist": "npm run build:renderer && electron-builder"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.23.1"
  },
  "build": {
    "appId": "com.clockyplaytime.app",
    "productName": "Clocky Playtime Factory",
    "files": [
      "electron/**/*",
      "index.html",
      "dist/**/*",
      "public/**/*"
    ],
    "directories": {
      "output": "release"
    }
  }
}
